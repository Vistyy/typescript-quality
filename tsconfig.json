{
  "extends": "./tsconfig/base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["oxlint.config.mjs", "oxlint/**/*.mjs", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "vendor/anti-slop"]
}
