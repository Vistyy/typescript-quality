{
  "name": "@syzom/typescript-quality",
  "version": "0.3.0",
  "description": "Pinned shared TypeScript, Biome, Oxlint, anti-slop, and Effect v4 quality configuration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vistyy/typescript-quality.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "files": [
    "dist",
    "biome",
    "oxlint",
    "tsconfig",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./biome": "./biome/base.json",
    "./oxlint": {
      "types": "./oxlint/base.d.ts",
      "default": "./oxlint/base.mjs"
    },
    "./tsconfig": "./tsconfig/base.json",
    "./tsconfig/effect": "./tsconfig/effect.json",
    "./anti-slop": "./dist/index.js",
    "./package.json": "./package.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/effect.json": "./tsconfig/effect.json",
    "./anti-slop/effect": "./dist/upstream/effect/index.js",
    "./anti-slop/canonical": "./dist/upstream/index.js",
    "./oxlint/base.mjs": {
      "types": "./oxlint/base.d.ts",
      "default": "./oxlint/base.mjs"
    },
    "./oxlint/effect": {
      "types": "./oxlint/effect.d.ts",
      "default": "./oxlint/effect.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "quality:prepare": "pnpm run build && effect-tsgo patch --oxlint --no-typescript",
    "quality": "pnpm run quality:prepare && biome check --error-on-warnings . && oxlint --config oxlint.config.mjs .",
    "sync:rules": "pnpm run build && tsx scripts/sync-rule-severities.ts",
    "check:rules": "pnpm run build && tsx scripts/sync-rule-severities.ts --check",
    "check": "pnpm run quality && pnpm run check:rules && tsx test/packed-consumer.ts"
  },
  "dependencies": {
    "@oxlint/plugins": "1.82.0"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/tsgo": "0.45.0",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/tsgo": "0.45.0",
    "@types/node": "22.20.2",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
